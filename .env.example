# Copy to .env and adjust.

# SurrealDB (start one with: surreal start --user root --pass root memory)
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=contextlayer
SURREAL_DB=main

# Password for the read-only login that text-to-SurrealQL runs as. Set it to a long
# random string so concurrent `ctx sql` / `ctx chat` processes share it.
CL_VIEWER_PASS=

# Embeddings: "fastembed" runs a local model (downloads ~130 MB once);
# "hash" is an offline stand-in with no notion of meaning, for tests.
CL_EMBEDDER=fastembed
CL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Generation (ctx ask / sql / chat). Needs an Anthropic API key.
CL_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
